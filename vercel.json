{
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=()" }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.(?:css|js|svg|webp|png|jpg|jpeg|pdf|woff2|mp4|xml|txt))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "machine", "value": "bean-front" }],
      "destination": "/machines.html#bean-to-cup",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "machine", "value": "bean-angle" }],
      "destination": "/machines.html#bean-to-cup",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "machine", "value": "filter-front" }],
      "destination": "/machines.html#filter-coffee-machine",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "machine", "value": "filter-angle" }],
      "destination": "/machines.html#filter-coffee-machine",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "has": [{ "type": "query", "key": "machine", "value": "bean-front" }],
      "destination": "/machines.html#bean-to-cup",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "has": [{ "type": "query", "key": "machine", "value": "bean-angle" }],
      "destination": "/machines.html#bean-to-cup",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "has": [{ "type": "query", "key": "machine", "value": "filter-front" }],
      "destination": "/machines.html#filter-coffee-machine",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "has": [{ "type": "query", "key": "machine", "value": "filter-angle" }],
      "destination": "/machines.html#filter-coffee-machine",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    }
  ]
}
